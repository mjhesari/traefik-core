# ── Image / container ──────────────────────────────────────────
TRAEFIK_VERSION=v3.6.1
TRAEFIK_CONTAINER_NAME=traefik
TRAEFIK_RESTART=unless-stopped

# ── Shared Docker network (project stacks join this as external) ─
TRAEFIK_NETWORK=traefik

# ── Host ↔ container ports ─────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_WEB_PORT=80
TRAEFIK_WEBSECURE_PORT=443

# ── HTTP → HTTPS redirect ──────────────────────────────────────
HTTP_REDIRECT_TO=websecure
HTTP_REDIRECT_SCHEME=https

# ── Logging / dashboard ────────────────────────────────────────
LOG_LEVEL=INFO
DASHBOARD_ENABLED=true
DASHBOARD_INSECURE=false

# ── Docker provider ────────────────────────────────────────────
DOCKER_ENDPOINT=unix:///var/run/docker.sock
DOCKER_SOCK=/var/run/docker.sock
EXPOSED_BY_DEFAULT=false
FILE_WATCH=true

# ── Let's Encrypt (required) ───────────────────────────────────
ACME_EMAIL=you@example.com
# Production (default):
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
# Staging (test certificates — uncomment to use instead):
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory
